{
  "uid": "borrower-truth-ops",
  "title": "Borrower Truth: operations",
  "schemaVersion": 39,
  "refresh": "5s",
  "time": {"from": "now-30m", "to": "now"},
  "panels": [
    {"type": "stat", "title": "System health (1 = up)", "gridPos": {"x": 0, "y": 0, "w": 12, "h": 5},
     "datasource": {"uid": "prom"},
     "targets": [{"expr": "bt_system_up", "legendFormat": "{{system}}"}],
     "options": {"colorMode": "background", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"]}},
     "fieldConfig": {"defaults": {"thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}}}},
    {"type": "stat", "title": "Cases by verdict", "gridPos": {"x": 12, "y": 0, "w": 12, "h": 5},
     "datasource": {"uid": "prom"},
     "targets": [{"expr": "bt_cases", "legendFormat": "{{verdict}}"}],
     "options": {"reduceOptions": {"calcs": ["lastNotNull"]}}},
    {"type": "timeseries", "title": "Seconds per system (last run)", "gridPos": {"x": 0, "y": 5, "w": 12, "h": 8},
     "datasource": {"uid": "prom"},
     "targets": [{"expr": "bt_system_seconds", "legendFormat": "{{system}}"}]},
    {"type": "timeseries", "title": "Signals per system (last run)", "gridPos": {"x": 12, "y": 5, "w": 12, "h": 8},
     "datasource": {"uid": "prom"},
     "targets": [{"expr": "bt_system_signals", "legendFormat": "{{system}}"}]},
    {"type": "timeseries", "title": "Streaming: payments processed per second", "gridPos": {"x": 0, "y": 13, "w": 8, "h": 8},
     "datasource": {"uid": "prom"},
     "targets": [{"expr": "rate(bt_stream_events_total[1m])", "legendFormat": "events/s"}]},
    {"type": "timeseries", "title": "Streaming: payment -> signal latency (s)", "gridPos": {"x": 8, "y": 13, "w": 8, "h": 8},
     "datasource": {"uid": "prom"},
     "targets": [{"expr": "bt_stream_latency_seconds", "legendFormat": "p{{quantile}}"}]},
    {"type": "timeseries", "title": "Fallbacks: dead letters, duplicates, template drafts", "gridPos": {"x": 16, "y": 13, "w": 8, "h": 8},
     "datasource": {"uid": "prom"},
     "targets": [
       {"expr": "bt_stream_dlq_total", "legendFormat": "dead-letter messages"},
       {"expr": "bt_stream_duplicates_total", "legendFormat": "duplicates dropped"},
       {"expr": "bt_drafts_total{source=\"TEMPLATE_FALLBACK\"}", "legendFormat": "drafts: model down, template used"}]},
    {"type": "timeseries", "title": "Streaming signals by type", "gridPos": {"x": 0, "y": 21, "w": 12, "h": 8},
     "datasource": {"uid": "prom"},
     "targets": [{"expr": "bt_stream_signals_total", "legendFormat": "{{type}}"}]},
    {"type": "timeseries", "title": "Human decisions on proposed fixes", "gridPos": {"x": 12, "y": 21, "w": 12, "h": 8},
     "datasource": {"uid": "prom"},
     "targets": [{"expr": "bt_decisions_total", "legendFormat": "{{decision}}"}]}
  ]
}
