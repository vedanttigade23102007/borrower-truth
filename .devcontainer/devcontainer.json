{
  "name": "borrower-truth",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "hostRequirements": {"cpus": 4, "memory": "16gb"},
  "features": {
    "ghcr.io/devcontainers/features/java:1": {"version": "21"},
    "ghcr.io/devcontainers/features/node:1": {"version": "22"},
    "ghcr.io/devcontainers/features/docker-in-docker:2": {"moby": false},
    "ghcr.io/devcontainers/features/sshd:1": {}
  },
  "postCreateCommand": "pip install uv && uv sync --extra stream && uv run python -m bt.datagen.generate --out data/out/demo",
  "forwardPorts": [3000, 3001, 8080, 8081, 9090, 9092],
  "portsAttributes": {
    "3000": {"label": "Console"},
    "3001": {"label": "Grafana"},
    "8081": {"label": "Case service"}
  }
}
